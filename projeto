def proxima_data(dia_alvo):
    dias_restantes = (dia_alvo - hj_dt.weekday()) % 7
    if dias_restantes <= 0:
        dias_restantes += 7
    return (hj_dt + timedelta(days=dias_restantes)).strftime('%d/%m/%Y')

