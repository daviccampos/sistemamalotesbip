# ===================== BIP: LEITOR DE CÓDIGO DE BARRAS (início) =====================
# Código da etiqueta = 35 dígitos: [CEP(8) + fixo(8) + bloco do posto(9)] [00001] [nº do malote, 5 dígitos]
# A "chave" do posto é tudo que vem antes dos 10 últimos dígitos. O vínculo chave -> posto
# é aprendido sozinho (pergunta 1 vez) e gravado em postos_codigos.csv, na mesma pasta do Excel.
ORIGEM_DIA = {'SEG': C0, 'TER': C1, 'QUA': C2, 'QUI': C3, 'SEX': C4, 'CAP': CAPITAL}
ARQUIVO_CODIGOS = os.path.join(obter_caminho(), "postos_codigos.csv")

def separar_codigo(bruto):
    dig = ''.join(ch for ch in str(bruto) if ch in '0123456789')
    if len(dig) != 35:
        return None, None
    return dig[:-10], str(int(dig[-5:]))

def carregar_codigos():
    mapa = {}
    if os.path.exists(ARQUIVO_CODIGOS):
        try:
            with open(ARQUIVO_CODIGOS, newline='', encoding='utf-8-sig') as f:
                for linha in csv.reader(f, delimiter=';'):
                    if len(linha) >= 2 and linha[0].startswith('C') and linha[1].strip() in TODAS:
                        mapa[linha[0][1:].strip()] = linha[1].strip()
        except Exception as e:
            print(f"Aviso: não consegui ler {ARQUIVO_CODIGOS}: {e}")
    return mapa

def salvar_codigo(chave, posto):
    # só ACRESCENTA uma linha (nunca reescreve o arquivo), então não há risco de perder o cadastro
    try:
        novo = not os.path.exists(ARQUIVO_CODIGOS)
        with open(ARQUIVO_CODIGOS, 'a', newline='', encoding='utf-8-sig') as f:
            w = csv.writer(f, delimiter=';')
            if novo:
                w.writerow(['codigo', 'posto'])
            w.writerow(['C' + chave, posto])  # o "C" na frente impede o Excel de estragar o número
        return True
    except Exception as e:
        sg.popup_error(f"Não consegui gravar postos_codigos.csv (está aberto?).\nO vínculo vale só até fechar o programa.\n{e}")
        return False

def perguntar_posto(ml):
    lay_p = [[sg.Text(f'Código novo (malote {ml}). Qual posto é este?', font=('Arial', 12, 'bold'))],
             [sg.Text('Buscar:'), sg.Input(key='-F-', size=(45, 1), enable_events=True)],
             [sg.Listbox(values=TODAS, size=(55, 12), key='-L-', font=('Arial', 11))],
             [sg.Button('SALVAR VÍNCULO', key='-OK-'), sg.Button('CANCELAR', key='-CANC-')]]
    w = sg.Window('Cadastrar código', lay_p, modal=True, finalize=True)
    escolhido = None
    while True:
        ev, vl = w.read()
        if ev in (None, '-CANC-'):
            break
        if ev == '-F-':
            f = vl['-F-'].upper()
            w['-L-'].update(values=[c for c in TODAS if f in c])
        if ev == '-OK-':
            if vl['-L-']:
                escolhido = vl['-L-'][0]
                break
            sg.popup_error('Selecione um posto na lista!')
    w.close()
    return escolhido

def foco_bip(janela, p):
