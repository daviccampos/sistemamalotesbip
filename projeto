window = sg.Window('Sistema Malotes', layout, finalize=True, resizable=True)
window.maximize()
for _k in ('SEG', 'TER', 'QUA', 'QUI', 'SEX', 'CAP', 'REC'):  # ===== BIP
    window[f'BIP_{_k}'].bind('<Return>', '_ENTER')  # ===== BIP: o Enter do leitor gera o evento BIP_xxx_ENTER

# Tira o foco do campo da data ao iniciar e coloca no Servidor
window['S_SEG'].set_focus()

cnt_rec = 0

def obter_chave_aba(aba_nome):
    if 'SEGUNDA' in aba_nome: return 'SEG'
    if 'TERÇA' in aba_nome: return 'TER'
    if 'QUARTA' in aba_nome: return 'QUA'
    if 'QUINTA' in aba_nome: return 'QUI'
    if 'SEXTA' in aba_nome: return 'SEX'
    if 'CAPITAL' in aba_nome: return 'CAP'
    return 'REC'

while True:
    event, values = window.read()
    if event in (None, 'SAIR'): break

    # Remove o foco do campo da data ao trocar de aba
    if event == '-TABGROUP-':
        chave = obter_chave_aba(values['-TABGROUP-'])
        window[f'S_{chave}'].set_focus()

    if event.startswith('L_'):
        p = event.split('_')[1]
        if values[event]:
            window[f'D_{p}'].update(values[event][0])
            window[f'M_{p}'].set_focus()

    if event.startswith('B_'):
        p = event.split('_')[1]
        v = values[event].upper()
        ref = LISTAS[p]
        window[f'L_{p}'].update(values=[c for c in ref if v in c])

    # ===== BIP: leitura do código de barras (automática: dispara sozinho ao completar 35 dígitos) =====
    if event.startswith('BIP_'):
        p = event.split('_')[1]
        via_enter = event.endswith('_ENTER')
        dig = ''.join(ch for ch in str(values.get(f'BIP_{p}') or '') if ch in '0123456789')
        agora = time.time()
        if not via_enter:
            if 1 < len(dig) < 35 and agora - ULT_BIP.get(p, 0) > 2.0:
                dig = dig[-1:]   # sobra antiga de leitura incompleta: recomeça só com o dígito novo
                window[f'BIP_{p}'].update(dig)
            ULT_BIP[p] = agora
        if len(dig) < 35:
            if via_enter and dig:   # o leitor mandou Enter, mas o código veio incompleto/diferente
                window[f'BIP_{p}'].update('')
                window[f'LOG_{p}'].update("⚠ Código incompleto ou diferente do padrão (esperado: 35 dígitos). Bipe de novo.", text_color='red')
                foco_bip(window, p)
            continue   # ainda chegando os dígitos: espera completar os 35
        resto = dig[35:]   # se sobrou algo (bip seguinte já chegando), volta pro campo
        window[f'BIP_{p}'].update(resto)
        chave, ml = separar_codigo(dig[:35])
        if not values[f'S_{p}'].strip():
            window[f'BIP_{p}'].update('')
            sg.popup_error("Preencha o nome do Servidor antes de bipar!")
            window[f'S_{p}'].set_focus()
            continue
        posto = CODIGOS.get(chave)
        if posto is None:
            posto = perguntar_posto(ml)
            if posto is None:
                foco_bip(window, p)
                continue
            CODIGOS[chave] = posto
            salvar_codigo(chave, posto)
        data_reg = values[f'DATA_{p}'].strip()
        aba_bip = 'Recebidos' if p == 'REC' else 'Enviados Capital' if p == 'CAP' else 'Enviados Interior'
        if (aba_bip, data_reg, ml) in BIPADOS:
            window[f'LOG_{p}'].update(f"⚠ Malote {ml} já foi registrado em {data_reg}. Nada foi feito.", text_color='red')
            foco_bip(window, p)
            continue
        if p in ORIGEM_DIA and posto not in ORIGEM_DIA[p]:
            if sg.popup_yes_no(f"{posto}\nNÃO faz parte desta aba.\n\nRegistrar mesmo assim?") != 'Yes':
                foco_bip(window, p)
                continue
        window[f'LOG_{p}'].update(text_color='green')
        window[f'D_{p}'].update(posto)
        window[f'M_{p}'].update(ml)
        window.write_event_value(f'R_{p}', None)   # dispara o REGISTRAR normal, com a mesma lógica de sempre
        if len(resto) >= 35:
            window.write_event_value(f'BIP_{p}_ENTER', None)   # já tem outro código completo esperando

    if event.startswith('R_'):
        p = event.split('_')[1]
        aba_sh = 'Recebidos' if p == 'REC' else 'Enviados Capital' if p == 'CAP' else 'Enviados Interior'
        dt, ml, sv = values[f'D_{p}'], values[f'M_{p}'].strip(), values[f'S_{p}'].strip().upper()
        data_registro = values[f'DATA_{p}'].strip()

        if not dt:
            sg.popup_error("Selecione um Destino/Origem na lista!")
            continue
        if not sv:
            sg.popup_error("Preencha o nome do Servidor!")
            continue
        if not ml:
            sg.popup_error("Preencha o Nº do Malote!")
            continue

        try:
            # Lê o histórico da aba escolhida[cite: 3]
            try:
                old = pd.read_excel(ARQUIVO, sheet_name=aba_sh)
            except:
                old = pd.DataFrame(columns=['Data', 'Posto', 'Malote', 'Servidor'])

            if not old.empty and 'Malote' in old.columns:
                old['Malote'] = old['Malote'].astype(str)

            # Verifica se já existe registro do mesmo posto na mesma data[cite: 3]
            mascara = (old['Data'] == data_registro) & (old['Posto'] == dt)

            if mascara.any():
                # Concatena o novo malote na mesma linha do Excel[cite: 3]
                idx = old[mascara].index[0]
                malotes_atuais = str(old.loc[idx, 'Malote'])
                if ml not in malotes_atuais.split(', '):
                    old.loc[idx, 'Malote'] = f"{malotes_atuais}, {ml}"
                    old.loc[idx, 'Servidor'] = sv
            else:
                # Cria uma linha nova se for o primeiro malote do dia/posto[cite: 3]
                novo = pd.DataFrame([{'Data': data_registro, 'Posto': dt, 'Malote': str(ml), 'Servidor': sv}])
                old = pd.concat([old, novo], ignore_index=True)

            # Salva no arquivo Excel[cite: 3]
            with pd.ExcelWriter(ARQUIVO, engine='openpyxl', mode='a' if os.path.exists(ARQUIVO) else 'w', if_sheet_exists='replace' if os.path.exists(ARQUIVO) else None) as writer:
                old.to_excel(writer, sheet_name=aba_sh, index=False)
            
            if p == 'REC':
                cnt_rec += 1
                window['-COUNT_REC-'].update(f'Total cadastrado: {cnt_rec}')
            else:
                if dt in LISTAS[p]:
                    LISTAS[p].remove(dt)
                window[f'L_{p}'].update(values=LISTAS[p])
                window[f'-COUNT_{p}-'].update(f'Restantes: {len(LISTAS[p])}')
            
            window[f'LOG_{p}'].update(f"✔ Registrado para {dt} | Malote: {ml} ({data_registro})")
            
            window[f'M_{p}'].update('')
            window[f'D_{p}'].update('')
            window[f'B_{p}'].update('')
            sg.popup_quick_message("✔ Registrado!", background_color='green')
            BIPADOS.add((aba_sh, data_registro, ml))  # ===== BIP
            foco_bip(window, p)  # ===== BIP
        except Exception as e:
            sg.popup_error(f"FECHE O EXCEL! Erro: {e}")

    if event in ['P_INT', 'P_CAP', 'ABRIR EXCEL']:
        if not os.path.exists(ARQUIVO):
            sg.popup("O arquivo ainda não existe. Registre o primeiro malote primeiro!")
            continue

        if event == 'ABRIR EXCEL':
            try: os.startfile(ARQUIVO)
            except: sg.popup_error("Não foi possível abrir o arquivo.")
            continue

        ori = 'Enviados Interior' if event == 'P_INT' else 'Enviados Capital'
        aba_p = 'PROTOCOLO ' + ('INTERIOR' if event == 'P_INT' else 'CAPITAL')
        try:
            df = pd.read_excel(ARQUIVO, sheet_name=ori)
            
            chave_atual = obter_chave_aba(values['-TABGROUP-'])
            data_busca = values[f'DATA_{chave_atual}']
            
            hj = df[df['Data'] == data_busca][['Posto', 'Malote']]
            if not hj.empty:
                with pd.ExcelWriter(ARQUIVO, engine='openpyxl', mode='a', if_sheet_exists='replace') as writer:
                    hj.to_excel(writer, sheet_name=aba_p, index=False, startrow=2)
                    ws = writer.sheets[aba_p]
                    ws['A1'], ws['A2'] = f"MANIFESTO - {aba_p.split()[-1]}", f"DATA: {data_busca}"
                    ws.merge_cells('A1:B1')
                    ws['A1'].font = Font(bold=True, size=14); ws['A1'].alignment = Alignment(horizontal='center')
                    fina = Side(style='thin')
                    for r in ws.iter_rows(min_row=3, max_row=ws.max_row, min_col=1, max_col=2):
                        for cell in r:
                            cell.border = Border(left=fina, right=fina, top=fina, bottom=fina)
                            cell.alignment = Alignment(horizontal='center')
                    ws.column_dimensions['A'].width = 45; ws.column_dimensions['B'].width = 25
                    ult_lin = ws.max_row + 2
                    ws.cell(row=ult_lin, column=1, value=f"TOTAL DE MALOTES: {len(hj)}").font = Font(bold=True)
                    ws.cell(row=ult_lin+3, column=1, value="_________________________________")
                    ws.cell(row=ult_lin+4, column=1, value="ASSINATURA CORREIOS")
                os.startfile(ARQUIVO)
            else: sg.popup(f"Sem registros para a data {data_busca} neste protocolo!")
        except Exception as e: sg.popup_error(f"Erro ao gerar protocolo! O Excel está aberto?\nDetalhes: {e}")

window.close()
